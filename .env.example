# LLM (runtime agent calls)
OPENAI_API_KEY=sk-placeholder

# Postgres + pgvector (memory and retrieval)
DATABASE_URL=postgresql://tra:tra@localhost:5432/ticket_agent

# Retrieval backend for retrieve_policy: lexical | dense | hybrid. dense is
# the measured choice (ADR 0004); unset falls back to lexical, which needs
# nothing. dense and hybrid need Postgres (docker compose up -d) and
# OPENAI_API_KEY.
RETRIEVAL_BACKEND=dense
EMBEDDING_MODEL=text-embedding-3-small
# Cosine-similarity floor for dense hits. Mandatory when the backend is dense
# or hybrid. 0.30 is the value the calibration rule picked; see ADR 0004
# before changing it, and rerun `evals.retrieval_baseline --calibrate-floor`.
RETRIEVAL_DENSE_FLOOR=0.30

# Agent loop model. A config value, recorded with every run.
LLM_MODEL=gpt-4o-mini
# Hard cap per eval run, in USD. A run that would exceed it aborts.
EVAL_SPEND_CAP_USD=1.00
# Retrieval guardrail: block (a hallucinated policy fact stops the reply and
# escalates) or detect (logged and counted, reply still sent). ADR 0007.
GUARDRAIL_MODE=block

# Agent loop budgets. Empty uses the defaults in src/agent/config.py.
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=
AGENT_MAX_WALL_CLOCK_SECONDS=

# Memory layer toggle (stateless baseline must stay runnable)
MEMORY_ENABLED=true

LOG_LEVEL=INFO
