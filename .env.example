# LLM (runtime agent calls)
OPENAI_API_KEY=sk-placeholder

# Postgres + pgvector (memory and retrieval)
DATABASE_URL=postgresql://user:password@localhost:5432/ticket_agent

# Agent loop budgets
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=
AGENT_MAX_WALL_CLOCK_SECONDS=

# Memory layer toggle (stateless baseline must stay runnable)
MEMORY_ENABLED=true

LOG_LEVEL=INFO
