# LLM (runtime agent calls)
OPENAI_API_KEY=sk-placeholder

# Postgres + pgvector (memory and retrieval)
DATABASE_URL=postgresql://tra:tra@localhost:5432/ticket_agent

# Retrieval backend for retrieve_policy: lexical | dense | hybrid.
# dense and hybrid need Postgres (docker compose up -d) and OPENAI_API_KEY.
RETRIEVAL_BACKEND=lexical
EMBEDDING_MODEL=text-embedding-3-small
# Cosine-similarity floor for dense hits. Mandatory when the backend is dense
# or hybrid; see ADR 0003. Calibrated by evals/retrieval_baseline.py.
RETRIEVAL_DENSE_FLOOR=

# Agent loop budgets
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=
AGENT_MAX_WALL_CLOCK_SECONDS=

# Memory layer toggle (stateless baseline must stay runnable)
MEMORY_ENABLED=true

LOG_LEVEL=INFO
